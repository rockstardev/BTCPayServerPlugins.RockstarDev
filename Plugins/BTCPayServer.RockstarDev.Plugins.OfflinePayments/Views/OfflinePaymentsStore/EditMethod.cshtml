@using BTCPayServer.RockstarDev.Plugins.OfflinePayments.ViewModels
@model OfflineMethodConfigViewModel
@{
    var isNew = string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = isNew ? "Add Payment Method" : "Edit Payment Method";
    Layout = "../Shared/_Layout.cshtml";
}

<div class="container-xl">
    <div class="row">
        <div class="col-xxl-constrain col-xl-8">

            <h2 class="mb-4">@ViewData["Title"]</h2>

            <form method="post" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="card mb-4">
                    <div class="card-header">Method Identity</div>
                    <div class="card-body">

                        <div class="form-group mb-3">
                            <label asp-for="MethodId" class="form-label"></label>
                            @* <input asp-for="MethodId" class="form-control text-uppercase"
                                   placeholder="ACH" @(isNew ? "" : "readonly") /> *@
                            <span asp-validation-for="MethodId" class="text-danger small"></span>
                            <div class="form-text">Unique identifier e.g. ACH, WIRE, CHECK, CASH. Cannot be changed after creation.</div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DisplayName" class="form-label"></label>
                            <input asp-for="DisplayName" class="form-control"
                                   placeholder="ACH Bank Transfer" />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="EstimatedSettlementTime" class="form-label"></label>
                            <input asp-for="EstimatedSettlementTime" class="form-control"
                                   placeholder="1-3 business days" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SupportContact" class="form-label"></label>
                            <input asp-for="SupportContact" class="form-control"
                                   placeholder="payments@yourcompany.com" />
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                            <label asp-for="IsEnabled" class="form-check-label">Enabled</label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input asp-for="RequiresManualConfirmation" class="form-check-input" type="checkbox" />
                            <label asp-for="RequiresManualConfirmation" class="form-check-label">
                                Require manual confirmation before settling invoice
                            </label>
                            <div class="form-text text-warning">
                                ⚠️ Disabling this auto-settles invoices when the customer clicks "I've sent payment".
                                Only disable if you fully trust your customer base.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">Bank / Account Details</div>
                    <div class="card-body">
                        <p class="text-secondary small">
                            These fields are shown to the customer on the checkout page with copy-to-clipboard.
                            Leave blank any fields that don't apply.
                        </p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="BankName" class="form-label"></label>
                                <input asp-for="BankName" class="form-control" placeholder="First National Bank" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BankAddress" class="form-label"></label>
                                <input asp-for="BankAddress" class="form-control" placeholder="123 Main St, City, ST 00000" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AccountName" class="form-label"></label>
                                <input asp-for="AccountName" class="form-control" placeholder="ACME Corp" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AccountAddress" class="form-label"></label>
                                <input asp-for="AccountAddress" class="form-control" placeholder="456 Business Ave" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="RoutingNumber" class="form-label"></label>
                                <input asp-for="RoutingNumber" class="form-control" placeholder="021000021" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AccountNumber" class="form-label"></label>
                                <input asp-for="AccountNumber" class="form-control" placeholder="123456789" />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ReferenceTemplate" class="form-label"></label>
                            <input asp-for="ReferenceTemplate" class="form-control"
                                   placeholder="Invoice {InvoiceId}" />
                            <div class="form-text">Use <code>{InvoiceId}</code> and <code>{StoreId}</code> as placeholders.</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">Customer Instructions</div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="Instructions" class="form-label"></label>
                            <textarea asp-for="Instructions" class="form-control" rows="8"
                                      placeholder="Markdown supported. Describe exactly what the customer should do to complete payment."></textarea>
                            <div class="form-text">Shown at the top of the checkout page. Markdown is rendered.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
