@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.RockstarDev.Plugins.OfflinePayments
@using BTCPayServer.RockstarDev.Plugins.OfflinePayments.Services
@inject IScopeProvider ScopeProvider
@inject OfflinePaymentsService OfflinePaymentsService
@{
	var storeId = ScopeProvider.GetCurrentStoreId();
	var hasPending = !string.IsNullOrEmpty(storeId) && await OfflinePaymentsService.HasPendingPayments(storeId);
}
@if (!string.IsNullOrEmpty(storeId))
{
	<li class="nav-item">
		<a layout-menu-item="@nameof(OfflinePaymentsNavPages.Methods)" asp-controller="OfflinePaymentsStore" asp-action="Index" asp-route-storeId="@storeId">
			<svg class="icon" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path fill="currentColor"
					  d="M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2H2V7Zm0 4h20v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6Zm3 3a1 1 0 0 0 0 2h2a1 1 0 0 0 0-2H5Zm4 0a1 1 0 0 0 0 2h4a1 1 0 0 0 0-2H9Z" />
			</svg>
			<span text-translate="true">Offline Payments</span>
			@if (hasPending)
			{
				<span class="ms-2 btcpay-status btcpay-status--enabled"></span>
			}
		</a>
		@if (ViewData.IsCategory(nameof(OfflinePaymentsNavPages)))
		{
			<ul class="nav flex-column">
				<li class="nav-item nav-item-sub">
					<a layout-menu-item="@nameof(OfflinePaymentsNavPages.Methods)" asp-controller="OfflinePaymentsStore" asp-action="Index"
					   asp-route-storeId="@storeId" text-translate="true">Payment Methods</a>
				</li>
				<li class="nav-item nav-item-sub">
					<a layout-menu-item="@nameof(OfflinePaymentsNavPages.PendingQueue)" asp-controller="OfflinePaymentsStore" asp-action="PendingQueue"
					   asp-route-storeId="@storeId" text-translate="true">Pending Queue</a>
					@if (hasPending)
					{
						<span class="ms-2 btcpay-status btcpay-status--enabled"></span>
					}
				</li>
			</ul>
		}
	</li>
}
